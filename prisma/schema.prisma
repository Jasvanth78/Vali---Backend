// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model AdPlacement {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  pageKey         String
  placementKey    String
  adFormat        String
  androidAdUnitId String   @default("")
  iosAdUnitId     String   @default("")
  isEnabled       Boolean  @default(false)
  sortOrder       Int      @default(0)
  frequencyCap    Int      @default(120)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@unique([pageKey, placementKey], map: "pageKey_1_placementKey_1")
  @@map("ad_placements")
}

model AdSettings {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  key           String   @unique(map: "key_1")
  globalEnabled Boolean  @default(false)
  pages         Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@map("ad_settings")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String   @unique
  rasi      String?
  star      String?
  dob       String?
  tob       String?
  pob       String?
  fcmToken  String?
  createdAt DateTime @default(now())
}

model RasiPalan {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  rasi      String
  type      String   // daily, weekly, monthly, yearly
  content   String
  date      DateTime
}

model Panchangam {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  date            DateTime
  sunrise         String
  sunset          String
  moonrise        String?
  moonset         String?
  tithi           String?  // e.g., "வளர்பிறை பிரதமை / Shukla Prathamai"
  nakshatram      String?  // e.g., "உத்திராடம் / Uttarashada"
  yogam           String?  // e.g., "சுபம் / Subham"
  karanam         String?  // e.g., "பவம் / Bavam"
  details         String   // General astronomical details
  nallaNeram      String?  // e.g., "09:15 AM - 10:15 AM | 04:45 PM - 05:45 PM"
  gowriNallaNeram String?  // e.g., "10:30 AM - 11:30 AM"
  rahuKalam       String?  // e.g., "01:30 PM - 03:00 PM"
  yemagandam      String?  // e.g., "06:00 AM - 07:30 AM"
  kuligai         String?  // e.g., "09:00 AM - 10:30 AM"
}


model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  message   String
  target    String   // all, rasi_name, user_id
  createdAt DateTime @default(now())
  categoryKey String?
  definitionKey String?
  destination String?
  parameters Json?
  runId String?
  recipientUserIds String[] @default([])
}

model NotificationGlobalSettings {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  key String @unique(map: "key_1")
  isEnabled Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("notification_settings")
}

model NotificationCategory {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  key String @unique(map: "key_1")
  name String
  description String
  isEnabled Boolean @default(true)
  isArchived Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("notification_categories")
}

model NotificationDefinition {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  key String @unique(map: "key_1")
  categoryKey String
  name String
  description String
  title String
  message String
  imageUrl String?
  destination String
  parameters Json
  audience Json
  trigger String
  isEnabled Boolean @default(true)
  isArchived Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("notification_definitions")
}

model NotificationRule {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name String
  definitionKey String
  trigger String
  templateId String?
  audience Json
  schedule Json?
  nextRun DateTime?
  lastRun DateTime?
  lastStatus String?
  isEnabled Boolean @default(true)
  isArchived Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("notification_rules")
}

model NotificationTemplate {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name String
  description String
  title String
  message String
  isEnabled Boolean @default(true)
  isArchived Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("notification_templates")
}

model NotificationCampaign {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  requestId String @unique(map: "requestId_1")
  definitionKey String
  title String
  message String
  imageUrl String?
  destination String
  parameters Json
  audience Json
  status String
  schedule Json?
  nextRun DateTime?
  lastRun DateTime?
  isEnabled Boolean @default(true)
  isArchived Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("notification_campaigns")
}

model NotificationSendLog {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  idempotencyKey String @unique(map: "idempotencyKey_1")
  definitionKey String
  categoryKey String?
  ruleId String?
  campaignId String?
  title String?
  message String?
  audience Json?
  source String
  status String
  attempted Int @default(0)
  accepted Int @default(0)
  failed Int @default(0)
  openCount Int @default(0)
  error String?
  createdAt DateTime @default(now())
  finishedAt DateTime?
  @@map("notification_logs")
}

model NotificationDeliveryAttempt {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  runId String @db.ObjectId
  tokenHash String
  userId String?
  deviceId String?
  status String
  errorCode String?
  createdAt DateTime @default(now())
  finishedAt DateTime?
  openedAt DateTime?
  @@unique([runId, tokenHash], map: "runId_1_tokenHash_1")
  @@map("notification_attempts")
}

model NotificationDevice {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  deviceId String @unique(map: "deviceId_1")
  secretHash String
  token String @unique(map: "token_1")
  platform String
  customNotificationIcons Boolean @default(false)
  topics String[]
  isEnabled Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("notification_devices")
}

model UserNotificationPreference {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  deviceId String
  categoryKey String
  isEnabled Boolean @default(true)
  updatedAt DateTime @updatedAt
  @@unique([deviceId, categoryKey], map: "deviceId_1_categoryKey_1")
  @@map("notification_preferences")
}

model NotificationSegment {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name String
  description String
  userIds String[]
  isEnabled Boolean @default(true)
  isArchived Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("notification_segments")
}

model Admin {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  email    String @unique
  password String
}

model Festival {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  date        DateTime
  description String?
  imageUrl    String?
}

model NallaNeram {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  date         DateTime
  morning      String   // e.g., "09:00 AM - 10:30 AM"
  evening      String   // e.g., "04:30 PM - 06:00 PM"
  gowriMorning String?  // e.g., "10:30 AM - 11:30 AM"
  gowriEvening String?  // e.g., "06:30 PM - 07:30 PM"
  rahuKalam    String?  // e.g., "01:30 PM - 03:00 PM"
  yemagandam   String?  // e.g., "06:00 AM - 07:30 AM"
  kuligai      String?  // e.g., "09:00 AM - 10:30 AM"
}


model Mugurtham {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  date      DateTime
  time      String
  type      String   // e.g., "Valarpirai", "Theipirai"
  month     String?  // explicitly store the month
  thithi    String?
  natchathiram String?
  yogam     String?
  lagnam    String?
  description String?
}

model AppContent {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  key   String @unique
  ta    String // Tamil content
  en    String // English content
  updatedAt DateTime @updatedAt
}

model AppCard {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  titleTa   String
  titleEn   String
  imageUrl  String?
  isEnabled Boolean  @default(true)
  order     Int      @default(0)
  screen    String   // screen key to navigate to
}

model Blog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  titleTa    String
  titleEn    String?
  categoryTa String?
  categoryEn String?
  contentTa  String
  contentEn  String?
  author     String?  @default("Valikatti Team")
  imageUrl   String?
  audioUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Event {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  titleTa       String
  titleEn       String?
  date          DateTime
  time          String?
  locationTa    String?
  locationEn    String?
  descriptionTa String?
  descriptionEn String?
  imageUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  content   String
  createdAt DateTime @default(now())
}

model VastuSasthiram {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  titleTa    String
  titleEn    String?
  contentTa  String
  contentEn  String?
  imageUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Sakunam {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  category   String   // 'kagam', 'palli_sollum', 'palli_vilum', 'aanthai'
  titleTa    String
  titleEn    String?
  contentTa  String
  contentEn  String?
  imageUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
model SpecialFeature {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  titleTa     String
  titleEn     String
  subtitleTa  String?
  subtitleEn  String?
  imageUrl    String?
  bgColor     String   @default("#FFFFFF")
  textColor   String   @default("#000000")
  isIcon      Boolean  @default(false)
  screen      String   
  order       Int      @default(0)
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Reel {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  youtubeVideoId String
  title          String
  description    String?
  hashtags       String[] @default([])
  likesCount     Int      @default(0)
  isEnabled      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model GovtHoliday {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  date      String   // e.g., "02"
  month     String   // e.g., "OCT"
  nameTa    String
  nameEn    String
  color     String   @default("#E8F5E9")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Proverb {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  contentTa   String
  contentEn   String?
  meaningTa   String?
  meaningEn   String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Independent image feed. Existing Blog/User models are intentionally unchanged.
model PosterCategory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  slug      String   @unique(map: "slug_1")
  nameTa    String
  nameEn    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  @@map("poster_categories")
}

model PosterPost {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  imageUrl    String
  caption     String?
  categoryId  String   @db.ObjectId
  status      String   @default("draft")
  isEnabled   Boolean  @default(true)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([status, isEnabled, publishedAt(sort: Desc), id(sort: Desc)], map: "status_1_isEnabled_1_publishedAt_-1__id_-1")
  @@index([categoryId, publishedAt(sort: Desc)], map: "categoryId_1_publishedAt_-1")
  @@map("poster_posts")
}

model PosterLike {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  postId    String   @db.ObjectId
  actorId   String
  createdAt DateTime @default(now())
  @@unique([postId, actorId], map: "postId_1_actorId_1")
  @@index([actorId, createdAt(sort: Desc)], map: "actorId_1_createdAt_-1")
  @@map("poster_likes")
}

model PosterBookmark {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  postId    String   @db.ObjectId
  actorId   String
  createdAt DateTime @default(now())
  @@unique([postId, actorId], map: "postId_1_actorId_1")
  @@index([actorId, createdAt(sort: Desc)], map: "actorId_1_createdAt_-1")
  @@map("poster_bookmarks")
}

