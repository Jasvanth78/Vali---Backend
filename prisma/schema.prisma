// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String   @unique
  rasi      String?
  star      String?
  dob       String?
  tob       String?
  pob       String?
  fcmToken  String?
  createdAt DateTime @default(now())
}

model RasiPalan {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  rasi      String
  type      String   // daily, weekly, monthly, yearly
  content   String
  date      DateTime
}

model Panchangam {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  date            DateTime
  sunrise         String
  sunset          String
  tithi           String?  // e.g., "வளர்பிறை பிரதமை / Shukla Prathamai"
  nakshatram      String?  // e.g., "உத்திராடம் / Uttarashada"
  yogam           String?  // e.g., "சுபம் / Subham"
  karanam         String?  // e.g., "பவம் / Bavam"
  details         String   // General astronomical details
  nallaNeram      String?  // e.g., "09:15 AM - 10:15 AM | 04:45 PM - 05:45 PM"
  gowriNallaNeram String?  // e.g., "10:30 AM - 11:30 AM"
  rahuKalam       String?  // e.g., "01:30 PM - 03:00 PM"
  yemagandam      String?  // e.g., "06:00 AM - 07:30 AM"
  kuligai         String?  // e.g., "09:00 AM - 10:30 AM"
}


model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  message   String
  target    String   // all, rasi_name, user_id
  createdAt DateTime @default(now())
}

model Admin {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  email    String @unique
  password String
}

model Festival {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  date        DateTime
  description String?
  imageUrl    String?
}

model NallaNeram {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  date         DateTime
  morning      String   // e.g., "09:00 AM - 10:30 AM"
  evening      String   // e.g., "04:30 PM - 06:00 PM"
  gowriMorning String?  // e.g., "10:30 AM - 11:30 AM"
  gowriEvening String?  // e.g., "06:30 PM - 07:30 PM"
  rahuKalam    String?  // e.g., "01:30 PM - 03:00 PM"
  yemagandam   String?  // e.g., "06:00 AM - 07:30 AM"
  kuligai      String?  // e.g., "09:00 AM - 10:30 AM"
}


model Mugurtham {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  date      DateTime
  time      String
  type      String   // e.g., "Valarpirai", "Theipirai"
  month     String?  // explicitly store the month
  thithi    String?
  natchathiram String?
  yogam     String?
  lagnam    String?
  description String?
}

model AppContent {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  key   String @unique
  ta    String // Tamil content
  en    String // English content
  updatedAt DateTime @updatedAt
}

model AppCard {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  titleTa   String
  titleEn   String
  imageUrl  String?
  isEnabled Boolean  @default(true)
  order     Int      @default(0)
  screen    String   // screen key to navigate to
}

model Blog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  titleTa    String
  titleEn    String?
  categoryTa String?
  categoryEn String?
  contentTa  String
  contentEn  String?
  author     String?  @default("Valikatti Team")
  imageUrl   String?
  audioUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Event {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  titleTa       String
  titleEn       String?
  date          DateTime
  time          String?
  locationTa    String?
  locationEn    String?
  descriptionTa String?
  descriptionEn String?
  imageUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  content   String
  createdAt DateTime @default(now())
}

model VastuSasthiram {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  titleTa    String
  titleEn    String?
  contentTa  String
  contentEn  String?
  imageUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Sakunam {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  category   String   // 'kagam', 'palli_sollum', 'palli_vilum', 'aanthai'
  titleTa    String
  titleEn    String?
  contentTa  String
  contentEn  String?
  imageUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
model SpecialFeature {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  titleTa     String
  titleEn     String
  subtitleTa  String?
  subtitleEn  String?
  imageUrl    String?
  bgColor     String   @default("#FFFFFF")
  textColor   String   @default("#000000")
  isIcon      Boolean  @default(false)
  screen      String   
  order       Int      @default(0)
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
